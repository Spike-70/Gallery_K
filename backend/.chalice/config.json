{
  "version": "2.0",
  "app_name": "gallery-k",
  "api_gateway_stage": "api",
  "automatic_layer": true,
  "lambda_memory_size": 1024,
  "lambda_timeout": 30,
  "minimum_compression_size": 1024,
  "environment_variables": {
    "APP_ENV": "dev"
  },
  "stages": {
    "dev": {
      "api_gateway_stage": "api",
      "environment_variables": {
        "APP_ENV": "dev",
        "LOG_LEVEL": "DEBUG"
      },
      "autogen_policy": false
    },
    "prod": {
      "api_gateway_stage": "api",
      "lambda_memory_size": 1536,
      "environment_variables": {
        "APP_ENV": "prod",
        "LOG_LEVEL": "INFO"
      },
      "autogen_policy": false
    }
  },
  "lambda_functions": {
    "scheduler": {
      "lambda_timeout": 120,
      "lambda_memory_size": 512
    }
  },
  "autogen_policy": false
}
