# 갤러리 K 백엔드 로컬 환경변수 (백엔드 문서 §8.1)
# 이 파일을 `.env`로 복사해서 쓴다. `.env`는 커밋하지 않는다.
#
# 여기 있는 값은 **배포로만 바뀌는 값**이다.
# 운영 중 조정되는 값(가입 잠금·알림 컷오프·아카이브 크기 등)은 `app_setting` 테이블에 있다.

APP_ENV=dev
APP_VERSION=local
LOG_LEVEL=DEBUG

# ── 데이터베이스 ──────────────────────────────────────────────────────────
# psycopg3 드라이버를 명시한다 (백엔드 문서 §14 — ARM64 휠 문제 회피)
DATABASE_URL=postgresql+psycopg://gallery:gallery@localhost:5432/gallery_k
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=8000

# ── 인증 ─────────────────────────────────────────────────────────────────
# 프로덕션에서는 32자 이상이어야 한다. 예: openssl rand -hex 32
JWT_SECRET=local-development-secret-change-me

# ── 미디어 (S3) ──────────────────────────────────────────────────────────
MEDIA_BUCKET=gallery-k-media-local
AWS_REGION=ap-northeast-2
# S3 호환 스토리지를 로컬에 띄웠을 때만 채운다. 실제 S3면 비워 둔다.
S3_ENDPOINT_URL=

# ── 웹 푸시 (VAPID) ──────────────────────────────────────────────────────
# 셋 다 있어야 발송을 시도한다. 비어 있으면 알림 발송이 비활성화된다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:curator@example.com

# ── 로컬 개발 CORS (API 문서 §2.11) ──────────────────────────────────────
DEV_CORS_ORIGIN=http://localhost:5173

# ── 마이그레이션 시드 (DB 문서 §9) ───────────────────────────────────────
# 없으면 마이그레이션이 실패한다 — 큐레이터 없는 배포는 동작 불가 상태다.
CURATOR_SEED_PHONE=01000000000
CURATOR_SEED_NAME=큐레이터
CURATOR_SEED_PASSWORD=change-me-on-first-login
