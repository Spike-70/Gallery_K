# 개발(`npm run dev`, `vite --mode development`) — 프런트엔드 아키텍처 문서 §15.1
#
# 프런트는 5173, 백엔드는 `chalice local`의 8000에서 뜬다. 그런데도 `/api` 상대 경로를
# 그대로 쓴다 — Vite dev 서버가 `/api`를 8000으로 프록시하며 접두를 떼기 때문이다
# (`vite.config.ts`). 배포와 같은 **동일 오리진** 조건을 로컬에서 재현하려는 것이고,
# 그래야 쿠키(`SameSite=Lax`)와 CSRF 헤더 동작이 개발에서 먼저 드러난다(API 문서 §2.11).
VITE_API_BASE_URL=/api
VITE_APP_ENV=dev

# 백엔드 `.env`의 `VAPID_PUBLIC_KEY`와 **같은 값**을 넣어야 구독이 성립한다.
# 비워 두면 알림 구독이 비활성화된다(가짜 구독을 만들지 않는다).
VITE_VAPID_PUBLIC_KEY=

# 로컬에는 CloudFront가 없어 `/media/public/*`가 없다. 개발용 대체 이미지를 둔다.
VITE_ENTRANCE_IMAGE_URL=/entrance-placeholder.svg
