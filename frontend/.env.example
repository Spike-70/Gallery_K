# 프런트엔드 환경 변수 — 프런트엔드 아키텍처 문서 §15.1
#
# Vite는 `.env` → `.env.[mode]` → `.env.local` 순으로 덮어쓴다.
# 공통값은 `.env`에, 환경별 값은 `.env.development` / `.env.production`에 둔다.
# 비밀값은 어느 파일에도 두지 않는다 — 여기 있는 값은 전부 번들에 그대로 실린다.

# API 기준 URL. 동일 오리진 배포이므로 상대 경로를 쓴다(API 문서 §2.11).
# 개발에서는 Vite dev 서버가 `/api`를 로컬 백엔드(`chalice local`)로 프록시한다.
VITE_API_BASE_URL=/api

# dev | staging | prod
VITE_APP_ENV=dev

# 웹푸시 VAPID **공개**키(백엔드 `VAPID_PUBLIC_KEY`와 같은 값).
# 비어 있으면 알림 구독이 비활성화된다. 개인키는 절대 여기에 두지 않는다.
VITE_VAPID_PUBLIC_KEY=

# 정문 이미지(공개 경로 고정 이미지). 비우면 `/media/public/entrance.jpg`를 쓴다.
VITE_ENTRANCE_IMAGE_URL=
