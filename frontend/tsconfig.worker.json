{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    /* 서비스워커는 DOM이 아니라 WebWorker 전역에서 돈다.
       한 tsconfig에 DOM과 WebWorker를 함께 두면 전역 선언이 충돌하므로 분리한다. */
    "lib": ["ES2023", "WebWorker"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],

    /* 서비스워커도 문구 단일 원천을 참조한다. */
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/sw.ts", "src/shared/config/messages.ts"]
}
