# 프로덕션(`npm run build`) — 프런트엔드 아키텍처 문서 §15.1
#
# CloudFront가 한 오리진 아래에서 `/api/*`는 API Gateway로, `/media/*`는 S3로,
# 나머지는 정적 자산으로 보낸다. 따라서 절대 URL을 쓰지 않는다 — 오리진이 하나이므로
# 프리플라이트가 발생하지 않고, 세션 쿠키가 교차 사이트가 되지 않는다(API 문서 §2.11).
VITE_API_BASE_URL=/api
VITE_APP_ENV=prod

# 배포 파이프라인이 주입한다. 비어 있으면 알림 구독이 조용히 꺼진다.
VITE_VAPID_PUBLIC_KEY=

VITE_ENTRANCE_IMAGE_URL=/media/public/entrance.jpg
